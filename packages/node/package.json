{
  "name": "@saas-maker/app-health",
  "version": "0.1.0",
  "description": "Privacy-first endpoint health telemetry for Node.js and Express.",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarthakagrawal927/app-health.git",
    "directory": "packages/node"
  },
  "homepage": "https://health.sassmaker.com",
  "bugs": {
    "url": "https://github.com/sarthakagrawal927/app-health/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bench": "vitest run --testNamePattern benchmark",
    "build": "tsup src/index.ts src/express.ts --format esm,cjs --dts --clean --external express",
    "pack:verify": "pnpm run build && node ../../scripts/verify-node-package.mjs",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "express": "^4.19.2",
    "supertest": "^7.0.0",
    "tsup": "8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "express": ">=4.19.0 <6"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
