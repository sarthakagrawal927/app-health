{
  "name": "app-health-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "workers_dev": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY",
      "dataset": "app_health_endpoint_v1",
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "vars": {
    "APP_HEALTH_DASHBOARD_HOST": "health.sassmaker.com",
    "APP_HEALTH_INGEST_HOST": "ingest.health.sassmaker.com",
    "APP_HEALTH_INGEST_ORIGIN": "https://ingest.health.sassmaker.com",
  },
  "env": {
    "local": {
      "vars": {
        "APP_HEALTH_MODE": "local",
      },
    },
  },
}
